set -e
ln -sfn /usr/share/@@NAME@@/bin/@@NAME@@ /usr/bin/@@NAME@@
update-alternatives --install /usr/bin/editor editor /usr/bin/@@NAME@@ 0
if command -v update-desktop-database >/dev/null; then update-desktop-database; fi
if command -v update-mime-database >/dev/null; then update-mime-database /usr/share/mime; fi
exit 0
